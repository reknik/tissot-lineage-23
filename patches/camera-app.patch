diff --git a/Android.bp b/Android.bp
index 8487fd4e7dbff5936baa745c8da9915c8d2d9735..f1c23aa0b3b715609e54d03e44b560ac5b893291 100644
--- a/Android.bp
+++ b/Android.bp
@@ -59,4 +59,9 @@ android_app {
         "libjni_tinyplanet",
         "libjni_jpegutil",
     ],
+
+    // The app is also distributed as a /data install on this port, so embed the
+    // JNI libraries in the APK; otherwise the loader cannot find
+    // libjni_jpegutil.so and still capture crashes with UnsatisfiedLinkError.
+    use_embedded_native_libs: true,
 }
