+	/*
+	 * MIPI RAW10: four 10-bit pixels packed into five bytes.  Sample a
+	 * decimated subset (every 256th pixel group) to keep the cost down;
+	 * the high bits of each pixel sit in the fifth byte.  The measurement
+	 * includes the sensor's black pedestal, so does the target.
+	 */
+	uint64_t acc = 0;
+	unsigned int n = 0;
+	for (size_t off = 0; off + 5 <= len; off += 5 * 256) {
+		uint8_t b4 = in[off + 4];
+		acc += (uint16_t(in[off + 0]) << 2) | (b4 & 0x03);
+		acc += (uint16_t(in[off + 1]) << 2) | ((b4 >> 2) & 0x03);
+		acc += (uint16_t(in[off + 2]) << 2) | ((b4 >> 4) & 0x03);
+		acc += (uint16_t(in[off + 3]) << 2) | ((b4 >> 6) & 0x03);
+		n += 4;
+	}
