+	if (mean < 1.0)
+		mean = 1.0;
+
+	const int32_t expMin = expIt->second.min().get<int32_t>();
+	const int32_t expMax = expIt->second.max().get<int32_t>();
+	const int32_t gainMin = gainIt->second.min().get<int32_t>();
+	const int32_t gainMax = gainIt->second.max().get<int32_t>();
