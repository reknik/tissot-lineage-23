+ * analogue gain, towards a fixed mid-scale target.  A multiplicative
+ * integrator with a per-frame slew limit keeps this stable.
+ *
+ * Units: V4L2_CID_EXPOSURE is integration time in lines (driver-specific),
+ * V4L2_CID_ANALOGUE_GAIN is the driver's gain code.  Both limits are read
+ * from the sensor's own control ranges, so nothing sensor-specific lives
+ * here.  If the request carries an explicit exposure (Android AE OFF /
+ * manual template), the frame is left alone.
+ */
+void SimpleCameraData::swAecFeedback(FrameBuffer *buffer, Request *request)
+{
+	const ControlInfoMap &ctrls = sensor_->controls();
+	auto expIt = ctrls.find(V4L2_CID_EXPOSURE);
+	auto gainIt = ctrls.find(V4L2_CID_ANALOGUE_GAIN);
+	if (expIt == ctrls.end() || gainIt == ctrls.end()) {
+		LOG(SimplePipeline, Error) << "AEC: no exposure/gain control";
+		return;
+	}
+
+	if (swAec_.frames < 40)
+		LOG(SimplePipeline, Error) << "AEC: frame " << swAec_.frames
+					   << " manual="
+					   << (request && request->controls().contains(controls::EXPOSURE_TIME));
+
+	if (request && request->controls().contains(controls::EXPOSURE_TIME))
+		return;
+
+	if (!swAec_.initialized) {
+		swAec_.exposure = expIt->second.def().get<int32_t>();
+		swAec_.gain = gainIt->second.def().get<int32_t>();
+		swAec_.initialized = true;
+	}
+
+	const FrameMetadata::Plane &plane = buffer->metadata().planes()[0];
+	if (plane.bytesused < 5)
+		return;
+
+	MappedFrameBuffer map(buffer, MappedFrameBuffer::MapFlag::Read);
+	if (!map.isValid()) {
+		if (swAec_.frames < 40)
+			LOG(SimplePipeline, Error) << "AEC: mmap failed";
+		return;
+	}
+	const uint8_t *in = map.planes()[0].data();
+	size_t len = std::min<size_t>(plane.bytesused, map.planes()[0].size());
