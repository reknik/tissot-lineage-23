  * dpu_hw_sspp_setup_rects()
  */
@@ -649,6 +713,32 @@ static void _setup_layer_ops(struct dpu_hw_sspp *c,
 		test_bit(DPU_SSPP_SMART_DMA_V2, &c->cap->features))
 		c->ops.setup_multirect = dpu_hw_sspp_setup_multirect;
 
+	/*
+	 * QSEED2 is the scaler on the DPU 1.x VIG pipes (msm8917, msm8937,
+	 * msm8953, msm8996).  It shares the QSEED3 register *addresses* from
