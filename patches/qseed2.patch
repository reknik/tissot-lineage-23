+	cfg->phase_step_y[DPU_QSEED2_COMP_0] = phase_step_y;
+	cfg->phase_step_x[DPU_QSEED2_COMP_3] = phase_step_x;
+	cfg->phase_step_y[DPU_QSEED2_COMP_3] = phase_step_y;
+	cfg->phase_step_x[DPU_QSEED2_COMP_2] =
