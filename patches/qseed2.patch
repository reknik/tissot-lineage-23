+static inline int dpu_hw_scaler2_build_cfg(u32 src_w, u32 src_h,
+					   u32 dst_w, u32 dst_h,
+					   u32 hsub, u32 vsub, bool yuv,
+					   u32 max_hdeci_exp,
+					   u32 max_vdeci_exp,
