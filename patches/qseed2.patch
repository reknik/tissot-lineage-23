+/*
+ * QSEED2 scaler programming.
+ *
+ * The QSEED2 block only implements the scaler configuration register at
+ * +0x04, the phase step registers at +0x10..+0x1c, the initial phase
+ * registers at +0x20..+0x2c and the sharpening block at +0x30.  There is
+ * no OP_MODE, preload, source/destination size or coefficient LUT
+ * register, so nothing outside that set may be written for these pipes.
+ *
+ * Sources:
+ *  - the in-tree mdp5 description of the same block
+ *    (drivers/gpu/drm/msm/registers/display/mdp5.xml: SCALE_CONFIG with
+ *    SCALEX_EN/SCALEY_EN at bit 0/1 and the per-component G/Y, CrCb and
+ *    alpha filters at bits 8/12/16 and 10/14/18),
+ *  - dpu_hw_scaler2_pack_regs() in dpu_hw_util.h, and
+ *  - Qualcomm's downstream mdss_mdp_qseed2_setup() and
+ *    mdss_mdp_pipe_position_update() (mdss_mdp_pp.c / mdss_mdp_pipe.c).
+ */
+void dpu_hw_sspp_setup_scaler2(struct dpu_hw_sspp *ctx,
+		struct dpu_hw_scaler2_cfg *scaler2_cfg)
+{
+	u32 decimation;
+
+	if (!ctx || !scaler2_cfg)
+		return;
+
+	dpu_hw_setup_scaler2(&ctx->hw, scaler2_cfg,
+			ctx->cap->sblk->scaler_blk.base);
+
+	/*
+	 * QSEED2 has a decimation block in front of the filtered scaler.
+	 * The horizontal/vertical fields hold a bitmask of the pixels that
+	 * are dropped, i.e. (1 << exponent) - 1: one pixel for 2x, three
+	 * for 4x, and so on.
+	 */
+	decimation = ((1 << scaler2_cfg->horz_decimate) - 1) << 8;
+	decimation |= (1 << scaler2_cfg->vert_decimate) - 1;
+	DPU_REG_WRITE(&ctx->hw, SSPP_DECIMATION_CONFIG, decimation);
+}
+
+/*
+ * QSEED2 sharpening block: four consecutive registers holding the
+ * sharpening strength and the edge, smooth and noise thresholds
+ * (downstream pp_sharp_config(), mdss_mdp_pp.c).
+ *
+ * The callback is wired up but intentionally never invoked: no DRM plane
+ * property exposes sharpening, so there is no caller and no automatic
+ * policy for it yet.
+ */
+void dpu_hw_sspp_setup_sharpening(struct dpu_hw_sspp *ctx,
+		struct dpu_hw_sharp_cfg *cfg)
+{
+	u32 offset;
+
+	if (!ctx || !cfg)
+		return;
+
+	offset = ctx->cap->sblk->scaler_blk.base + DPU_QSEED2_SHARP_OFFSET;
+	DPU_REG_WRITE(&ctx->hw, offset + 0x0, cfg->strength);
+	DPU_REG_WRITE(&ctx->hw, offset + 0x4, cfg->edge_thr);
+	DPU_REG_WRITE(&ctx->hw, offset + 0x8, cfg->smooth_thr);
+	DPU_REG_WRITE(&ctx->hw, offset + 0xc, cfg->noise_thr);
+}
+
