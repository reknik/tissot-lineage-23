+	cfg->vert_filter_y_rgb = (src_h_dec <= dst_h) ?
+		DPU_QSEED2_FILTER_BIL : DPU_QSEED2_FILTER_PCMN;
+	cfg->vert_filter_alpha = cfg->vert_filter_y_rgb;
+	cfg->vert_filter_uv = (cfg->src_height[DPU_QSEED2_COMP_1_2] <= dst_h) ?
