+/*
+ * QSEED2 register offsets, relative to the scaler block base.  The block
+ * reuses the VIG operation mode register at +0x00 and the QSEED3 register
+ * addresses from +0x04 onwards, but with an unrelated QSEED2 layout; see
+ * the struct dpu_hw_scaler2_cfg documentation in dpu_hw_util.h.
+ */
+#define QSEED2_SCALE_CONFIG		0x04
+#define QSEED2_PHASE_STEP_C03_X		0x10
+#define QSEED2_PHASE_STEP_C03_Y		0x14
+#define QSEED2_PHASE_STEP_C12_X		0x18
+#define QSEED2_PHASE_STEP_C12_Y		0x1c
+#define QSEED2_INIT_PHASE_C03_X		0x20
+#define QSEED2_INIT_PHASE_C03_Y		0x24
+#define QSEED2_INIT_PHASE_C12_X		0x28
+#define QSEED2_INIT_PHASE_C12_Y		0x2c
+
+void dpu_hw_setup_scaler2(struct dpu_hw_blk_reg_map *c,
+		const struct dpu_hw_scaler2_cfg *scaler2_cfg,
+		u32 scaler_offset)
+{
+	struct dpu_hw_scaler2_regs regs;
+
+	dpu_hw_scaler2_pack_regs(scaler2_cfg, &regs);
+
+	/*
+	 * Program the phase values and filters first and enable the scaler
+	 * in SCALE_CONFIG last.  A disabled scaler writes zeroes, which is
+	 * the clean way to turn a previously active scaler off.
+	 */
+	DPU_REG_WRITE(c, QSEED2_PHASE_STEP_C03_X + scaler_offset,
+		      regs.phase_step_c03_x);
+	DPU_REG_WRITE(c, QSEED2_PHASE_STEP_C03_Y + scaler_offset,
+		      regs.phase_step_c03_y);
+	DPU_REG_WRITE(c, QSEED2_PHASE_STEP_C12_X + scaler_offset,
+		      regs.phase_step_c12_x);
+	DPU_REG_WRITE(c, QSEED2_PHASE_STEP_C12_Y + scaler_offset,
+		      regs.phase_step_c12_y);
+	DPU_REG_WRITE(c, QSEED2_INIT_PHASE_C03_X + scaler_offset,
+		      regs.init_phase_c03_x);
+	DPU_REG_WRITE(c, QSEED2_INIT_PHASE_C03_Y + scaler_offset,
+		      regs.init_phase_c03_y);
+	DPU_REG_WRITE(c, QSEED2_INIT_PHASE_C12_X + scaler_offset,
+		      regs.init_phase_c12_x);
+	DPU_REG_WRITE(c, QSEED2_INIT_PHASE_C12_Y + scaler_offset,
+		      regs.init_phase_c12_y);
+	DPU_REG_WRITE(c, QSEED2_SCALE_CONFIG + scaler_offset, regs.config);
+}
