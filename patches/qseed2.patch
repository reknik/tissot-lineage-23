+	 * (vblank timeout / "wait for commit done returned -110") with a
+	 * blue line artefact over the navigation controls.  QSEED2 therefore
+	 * gets its own configuration and programming routine
+	 * (dpu_hw_sspp_setup_scaler2()) and must never be wired to
+	 * dpu_hw_sspp_setup_scaler3().
+	 *
+	 * See dpu_hw_scaler2_cfg in dpu_hw_util.h for the register layout and
+	 * its sources (registers/display/mdp5.xml and Qualcomm's downstream
+	 * mdss_mdp_qseed2_setup()).
+	 */
+	if (test_bit(DPU_SSPP_SCALER_QSEED2, &features)) {
+		c->ops.setup_scaler2 = dpu_hw_sspp_setup_scaler2;
+		c->ops.setup_sharpening = dpu_hw_sspp_setup_sharpening;
+	}
+
 	if (test_bit(DPU_SSPP_SCALER_QSEED3_COMPATIBLE, &features))
