+	if (cfg->scale_y) {
+		regs->config |= BIT(1);
+		regs->config |= (cfg->vert_filter_y_rgb & 0x3) << 10;
+		regs->config |= (cfg->vert_filter_uv & 0x3) << 14;
+		regs->config |= (cfg->vert_filter_alpha & 0x3) << 18;
